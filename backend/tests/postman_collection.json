              "path": ["api", "books"],
              "query": [
                {
                  "key": "min_price",
                  "value": "30"
                },
                {
                  "key": "max_price",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Test Pagination (limit=5&offset=5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Pagination returns at most 5 records\", function () {",
                  "    pm.expect(jsonData.data.length).to.be.at.most(5);",
                  "    pm.expect(jsonData.pagination.limit).to.eql(5);",
                  "    pm.expect(jsonData.pagination.offset).to.eql(5);",
                  "    pm.expect(jsonData.pagination.current_page).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
