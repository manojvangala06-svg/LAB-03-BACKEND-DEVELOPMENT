          "name": "POST Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Book created with correct attributes\", function () {",
                  "    pm.expect(jsonData.message).to.eql(\"Book created successfully\");",
                  "    pm.expect(jsonData.data.title).to.eql(\"System Design Interview\");",
                  "    pm.expect(parseFloat(jsonData.data.price)).to.eql(39.99);",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"createdBookId\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
