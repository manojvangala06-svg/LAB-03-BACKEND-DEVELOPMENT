    {
      "name": "3. Search, Filter, Sort & Pagination",
      "item": [
        {
          "name": "Search Books By Title (search_q=python)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"All returned titles contain 'python' (case-insensitive)\", function () {",
                  "    jsonData.data.forEach(function(book) {",
                  "        pm.expect(book.title.toLowerCase()).to.include(\"python\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?search_q=python",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "search_q",
                  "value": "python"
                }
              ]
            }
          }
        },
        {
          "name": "Sort Books By Price DESC",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Books are sorted in descending order of price\", function () {",
                  "    for (var i = 0; i < jsonData.data.length - 1; i++) {",
                  "        pm.expect(parseFloat(jsonData.data[i].price)).to.be.at.least(parseFloat(jsonData.data[i + 1].price));",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?order_by=price&order=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Books by Price Range (min_price & max_price)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"All books are within price range 30.00 and 50.00\", function () {",
                  "    jsonData.data.forEach(function(book) {",
                  "        var p = parseFloat(book.price);",
                  "        pm.expect(p).to.be.at.least(30.00);",
                  "        pm.expect(p).to.be.at.most(50.00);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?min_price=30&max_price=50",
