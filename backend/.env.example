# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
# Option 1: Direct Connection URL (Recommended for Neon and Render)
# Example: postgresql://username:password@ep-name.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookdb

# Option 2: Individual Connection Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookdb
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# ==========================================
# Security & Logging
# ==========================================
CORS_ORIGIN=*
LOG_LEVEL=info

